{
  "system": "openlpm",
  "root": "..",
  "description": "OpenLPM's own model of ITSELF as software (why each part was decided, what it actually enforces, what tables store it) -- not a model of the curricula/theories that researchers build INSIDE OpenLPM (strands, learning goals, theories). Layers run most-abstract (Decided) to most-concrete (Structure); the mappings between them are checked by scripts/self_model_check.py in the lab_manager repo (not copied here, to avoid drift).",
  "layers": [
    {
      "id": "L0",
      "name": "Decided",
      "question": "What was decided, by whom, and is it still the plan?"
    },
    {
      "id": "L1",
      "name": "Behavior",
      "question": "What does OpenLPM actually enforce or allow once running?"
    },
    {
      "id": "L2",
      "name": "Structure",
      "question": "What tables actually exist in the database?"
    }
  ],
  "diagram_layers": [
    "L0",
    "L1"
  ],
  "elements": [
    {
      "id": "decided.platform-foundation",
      "layer": "L0",
      "label": "Core platform: literature management, schema co-design, LPM data objects, peer review, evidence linking, discussion forums (the README's own feature list; migration 001)",
      "status": "implemented"
    },
    {
      "id": "decided.rfc0001-self-host-default",
      "layer": "L0",
      "label": "RFC-0001: every group self-hosts its own instance by default",
      "status": "retired",
      "note": "superseded by RFC-0002's hybrid hosting model (shared hosted instance by default; self-host is still possible but loses live Commons/federation)"
    },
    {
      "id": "decided.rfc0002-branches",
      "layer": "L0",
      "label": "RFC-0002 §3: a two-tier branch/fork/promote mechanism for drafting project content",
      "status": "retired",
      "note": "migration 016 (2026-09) checked live data directly, found every real project had exactly one branch (its trunk), and replaced branching with nested sub-projects plus a plain maturity flip; no branches UI remains in the frontend",
      "realized_by": [
        {
          "type": "sql_table",
          "migrations": "supabase/migrations",
          "name": "branches"
        }
      ],
      "acknowledged": {
        "kinds": [
          "retired-but-present"
        ],
        "reason": "migration 016 deliberately kept the table and one historical non-trunk branch record as real provenance, not live data -- not a regression",
        "on": "2026-10-02"
      }
    },
    {
      "id": "decided.rfc0002-projects-and-portfolios",
      "layer": "L0",
      "label": "RFC-0002 §1-2,6: multi-tenant projects, membership roles, personal portfolios referencing canonical content",
      "status": "implemented"
    },
    {
      "id": "decided.rfc0002-base-linking",
      "layer": "L0",
      "label": "RFC-0002 §5: linking a project to the wider OpenEvo Foundational Repos for import",
      "status": "implemented",
      "note": "import-only; contribute-back (proposing changes into a Foundational Repo) was never built"
    },
    {
      "id": "decided.rfc0003-frameworks-and-standards",
      "layer": "L0",
      "label": "RFC-0003: versioned external frameworks/standards and how OpenLPM content maps to them",
      "status": "implemented"
    },
    {
      "id": "decided.rfc0004-structured-scope",
      "layer": "L0",
      "label": "RFC-0004 §1: structured, queryable project scope (jurisdiction, subject, school type)",
      "status": "implemented",
      "note": "built as normalized tables (migration 019) rather than the plain columns RFC-0004 originally sketched"
    },
    {
      "id": "decided.rfc0004-commons",
      "layer": "L0",
      "label": "RFC-0004 §4: Commons — cross-project permission grants plus reference-not-copy links between two projects' curriculum content (project_commons_links, commons_item_references)",
      "status": "proposed",
      "realized_by": [
        {
          "type": "sql_table",
          "migrations": "supabase/migrations",
          "name": "project_commons_links"
        }
      ]
    },
    {
      "id": "decided.rfc0006-commons-spaces",
      "layer": "L0",
      "label": "RFC-0006: the revised Commons mechanism (audit-logged, role-gated propose/review/decide), superseding RFC-0004 §3’s simpler can_edit flag",
      "status": "proposed",
      "realized_by": [
        {
          "type": "sql_table",
          "migrations": "supabase/migrations",
          "name": "audit_log"
        }
      ]
    },
    {
      "id": "decided.project-maturity-2026-09",
      "layer": "L0",
      "label": "Migrations 015-016: nested sub-projects plus a plain draft/established status flip, replacing branching as how a project matures",
      "status": "implemented"
    },
    {
      "id": "decided.groups-2026-10-02",
      "layer": "L0",
      "label": "Groups: member-run sub-teams within one project, each with a shared view",
      "status": "implemented"
    },
    {
      "id": "decided.federation-2026-10-02",
      "layer": "L0",
      "label": "Project federation: an owner shares some members' access laterally into a separate, independent project — distinct from RFC-0004's content-only Commons idea despite the similar motivation",
      "status": "implemented"
    },
    {
      "id": "decided.github-publication-strategy",
      "layer": "L0",
      "label": "Publish a project's content as an independent repo on the owner's own GitHub account",
      "status": "proposed",
      "note": "strategy and technical design locked 2026-10-01; nothing built"
    },
    {
      "id": "decided.incremental-utility-features",
      "layer": "L0",
      "label": "Small additions with no dedicated RFC: feedback widget, tutorials, audit log, personal favorites/annotations, method-to-concept links, AI prompt generator templates",
      "status": "implemented"
    },
    {
      "id": "behavior.project-membership-gate",
      "layer": "L1",
      "label": "is_project_member() / has_project_role(): the central membership and role check used across most tables",
      "status": "implemented",
      "realizes": [
        "decided.rfc0002-projects-and-portfolios"
      ],
      "realized_by": [
        {
          "type": "text_contains",
          "path": "supabase/migrations/004_projects_branches_portfolios.sql",
          "pattern": "CREATE OR REPLACE FUNCTION is_project_member"
        }
      ]
    },
    {
      "id": "behavior.portfolio-sharing-gate",
      "layer": "L1",
      "label": "is_portfolio_owner() / has_portfolio_share(): portfolio access, rewritten once already to fix a live infinite-recursion bug",
      "status": "implemented",
      "realizes": [
        "decided.rfc0002-projects-and-portfolios"
      ],
      "realized_by": [
        {
          "type": "text_contains",
          "path": "supabase/migrations/009_fix_portfolios_rls_recursion.sql",
          "pattern": "CREATE OR REPLACE FUNCTION is_portfolio_owner"
        }
      ]
    },
    {
      "id": "behavior.group-management-gate",
      "layer": "L1",
      "label": "is_group_member() / can_manage_groups(): group membership and who may create or delete a group",
      "status": "implemented",
      "realizes": [
        "decided.groups-2026-10-02"
      ],
      "realized_by": [
        {
          "type": "text_contains",
          "path": "supabase/migrations/075_project_groups.sql",
          "pattern": "CREATE OR REPLACE FUNCTION is_group_member"
        }
      ]
    },
    {
      "id": "behavior.admin-override-gate",
      "layer": "L1",
      "label": "is_admin(): bypasses ordinary membership checks for lab-wide administration",
      "status": "implemented",
      "realizes": [
        "decided.platform-foundation"
      ],
      "realized_by": [
        {
          "type": "text_contains",
          "path": "supabase/migrations/049_admin_user_management.sql",
          "pattern": "CREATE OR REPLACE FUNCTION is_admin"
        }
      ]
    },
    {
      "id": "behavior.federation-lifecycle",
      "layer": "L1",
      "label": "proposed -> accepted -> revoked federation status; granted_role can never be owner; acceptance creates a real project_members row",
      "status": "implemented",
      "realizes": [
        "decided.federation-2026-10-02"
      ],
      "realized_by": [
        {
          "type": "text_contains",
          "path": "supabase/migrations/084_project_federation.sql",
          "pattern": "CREATE TABLE IF NOT EXISTS project_federations"
        }
      ]
    },
    {
      "id": "behavior.project-maturity-flip",
      "layer": "L1",
      "label": "draft -> established status flip replacing branch/fork/promote",
      "status": "implemented",
      "realizes": [
        "decided.project-maturity-2026-09"
      ],
      "realized_by": [
        {
          "type": "text_contains",
          "path": "supabase/migrations/016_project_maturity.sql",
          "pattern": "maturity"
        }
      ]
    },
    {
      "id": "behavior.review-workflow",
      "layer": "L1",
      "label": "peer_review_assignments: pending -> in_progress -> completed, with an accept/reject/revise recommendation, across 8 different kinds of reviewable object",
      "status": "implemented",
      "realizes": [
        "decided.platform-foundation"
      ],
      "realized_by": [
        {
          "type": "text_contains",
          "path": "supabase/migrations/001_initial_schema.sql",
          "pattern": "peer_review_assignments"
        }
      ]
    },
    {
      "id": "behavior.evidence-maturity-staging",
      "layer": "L1",
      "label": "theories.evidentiary_maturity: theoretically-developed -> empirically-recovered -> tested-against-alternatives -> efficacy-demonstrated",
