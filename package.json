{
  "name": "openlpm",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "setup": "npm install",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "tsc -b --noEmit",
    "test:time": "node scripts/test_time_model.mjs",
    "test:structure": "node scripts/test_curriculum_structure.mjs",
    "test:comparison": "node scripts/test_comparison_model.mjs",
    "test:draft-links": "node scripts/test_draft_links.mjs",
    "test:review-state": "node scripts/test_review_state.mjs",
    "test:concept-source": "node scripts/test_concept_source.mjs",
    "test:concept-meanings": "node scripts/test_concept_meanings.mjs",
    "test:comparison-structure": "node scripts/test_comparison_structure.mjs",
    "test:dashboard-views": "node scripts/test_dashboard_views.mjs",
    "test:node-links": "node scripts/test_node_links.mjs && python scripts/test_generate_node_links_migration.py",
    "read-feedback": "node scripts/read-feedback.mjs",
    "docs:check": "node scripts/check_docs_freshness.mjs",
    "self-model:check": "python ../lab_manager/scripts/self_model_check.py self-model/manifest.json --root . --render docs/architecture/self-model.generated.md"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@supabase/supabase-js": "^2.39.0",
    "clsx": "^2.1.0",
    "cytoscape": "^3.34.2",
    "cytoscape-cose-bilkent": "^4.1.0",
    "cytoscape-dagre": "^4.0.1",
    "docx": "9.5.1",
    "exceljs": "^4.4.0",
    "html2canvas-pro": "2.5.2",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.303.0",
    "papaparse": "^5.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.28.0",
    "react-simple-maps": "^5.0.5"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.21.9",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.16",
    "playwright": "^1.63.0",
    "postcss": "^8.4.32",
    "typescript": "^5.3.3",
    "vite": "^5.4.11"
  }
}
